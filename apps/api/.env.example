# ---------------------------------------------------------------------------
# ReWear backend environment (@rewear/api)
# Copy to .env and fill in real values. NEVER commit the real .env file.
# See implementation.md §18 for the authoritative variable list.
# ---------------------------------------------------------------------------

# Node environment: development | test | production
NODE_ENV=development

# Port the Express server listens on
PORT=4000

# --- Database ---------------------------------------------------------------
# MongoDB Atlas connection string. MUST be a replica-set cluster (Atlas M0+),
# NOT a local standalone mongod — multi-document transactions (swap-accept
# flow, implementation.md §5.7) do not work on standalone instances.
# Format: mongodb+srv://<user>:<password>@<cluster>.mongodb.net/<dbname>?retryWrites=true&w=majority
MONGODB_URI=mongodb+srv://USERNAME:PASSWORD@CLUSTER.mongodb.net/rewear-dev?retryWrites=true&w=majority

# --- Auth -------------------------------------------------------------------
# Long random strings (e.g. `openssl rand -hex 32`)
JWT_ACCESS_SECRET=replace-with-random-32-byte-hex
JWT_REFRESH_SECRET=replace-with-different-random-32-byte-hex

# Fixed session window (§11): the whole login session dies this many minutes
# after login — refresh rotates the token but NEVER extends it, and the UI
# auto-logs-out at the deadline. Fractional values allowed (the session-expiry
# e2e boots its stack with SESSION_TTL_MINUTES=0.2). Default if unset: 15.
# SESSION_TTL_MINUTES=15

# --- Image storage (Cloudinary, free tier) ----------------------------------
# Format: cloudinary://<api_key>:<api_secret>@<cloud_name>
CLOUDINARY_URL=cloudinary://API_KEY:API_SECRET@CLOUD_NAME

# --- Vision classification (advisory-only, never blocks item creation) ------
# Groq (https://console.groq.com/keys) powers AI listing suggestions via the
# visionClassificationService. Optional: without a key the item form is fully
# manual — classification silently degrades to "no suggestion" (§14.4/§16).
# Model is pinned because Groq rotates their lineup; see their docs/models page.
GROQ_API_KEY=replace-with-groq-key
GROQ_VISION_MODEL=qwen/qwen3.8-27b

# --- CORS -------------------------------------------------------------------
# Comma-separated list of allowed origins (frontend dev/prod URLs)
CORS_ORIGIN=http://localhost:5173,http://127.0.0.1:5173

# --- Rate limiting (§11, optional — these defaults apply if unset) ----------
# Per-IP limit on POST /auth/register and POST /auth/login (each route has
# its own counter). Lower AUTH_RATE_LIMIT_MAX in production if you want it
# stricter; do not set it below what a shared office/NAT IP legitimately needs.
AUTH_RATE_LIMIT_MAX=20
AUTH_RATE_LIMIT_WINDOW_MS=900000

# Per-USER write-endpoint limits (P7-T2 — keyed on the authenticated user id,
# not IP). WRITE covers item + swap writes; CLASSIFY is the AI vision call's
# own tighter budget (highest-latency endpoint, §23) and does not count
# against WRITE. These defaults apply if unset.
WRITE_RATE_LIMIT_MAX=30
CLASSIFY_RATE_LIMIT_MAX=10
WRITE_RATE_LIMIT_WINDOW_MS=60000
