[TEMPLATE]
# ---------------------------------------------------------------------------
# ReWear frontend environment (@rewear/web)
# Copy to .env and fill in real values. NEVER commit the real .env file.
# ---------------------------------------------------------------------------

# Base URL of the ReWear backend API (no trailing slash).
# Local dev: leave at the relative '/api/v1' — the Vite dev proxy forwards
# /api/* to http://localhost:4000 (see apps/web/vite.config.js), which keeps
# the httpOnly refresh cookie first-party and sidesteps CORS entirely.
VITE_API_BASE_URL=/api/v1
